# Autenticación y seguridad
APP_USERNAME=
APP_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=false
LOCK_SETTINGS=false

# Proveedor de IA: "gemini" o "openai" (opcional; sin clave funciona el comparador automático)
AI_PROVIDER=gemini

# API Key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API Key de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firecrawl API (https://www.firecrawl.dev/app/api-keys)
# Modos: "fallback" (respaldo automático), "primary" (todas las tiendas con Firecrawl), "off"
FIRECRAWL_API_KEY=
FIRECRAWL_MODE=fallback

# Usar navegador Chromium (Playwright) como respaldo cuando una tienda requiere JS o bloquea HTTP directo
USE_PLAYWRIGHT_FALLBACK=true

# Tiempo máximo por tienda en segundos
STORE_TIMEOUT_SECONDS=25

# Máximo de resultados por tienda
MAX_RESULTS_PER_STORE=10
