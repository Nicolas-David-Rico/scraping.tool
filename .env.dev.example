# Plantilla de entorno DESARROLLO (copiar a .env para correr en local, NO subir .env a Git)
APP_USERNAME=
APP_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=false
LOCK_SETTINGS=false

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIRECRAWL_API_KEY=
FIRECRAWL_MODE=fallback

USE_PLAYWRIGHT_FALLBACK=true
STORE_TIMEOUT_SECONDS=25
MAX_RESULTS_PER_STORE=10
